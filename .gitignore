# Vendor documents. Every one of these was downloaded, not written here, and
# each is named, dated and graded in the README of the folder it sits in -
# which is what makes it findable again. Git would carry them forever.
RnD-Docs/Datasheets/**/*.pdf
RnD-Docs/Datasheets/**/*.zip
RnD-Docs/Datasheets/1.1-FRDM-IMX91S/FRDM-IMX91-DESIGNFILES/

# Hiwonder's own chassis CAD, untouched, 186 MB - past GitHub's 100 MB
# per-file limit, and re-downloadable from the vendor.
RnD-Docs/3D-Drawings/*.3dm

# Written by make-assembly.py. assembly.stl is pure output; the .obj is a
# seed that the script rewrites in place - see 3D-Drawings/README.md.
RnD-Docs/3D-Drawings/assembly.stl
RnD-Docs/3D-Drawings/chassis-3deck-fascia.obj
